{
  "name": "sharepoint-browser-mcp-server",
  "version": "0.1.0",
  "description": "Read-only SharePoint MCP server using an authenticated Microsoft Edge session without Entra app registration.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/src/index.js",
    "prelogin": "npm run build",
    "login": "node --env-file-if-exists=.env --enable-source-maps dist/src/login.js",
    "dev": "npm run build && npm start",
    "pretest": "npm run build",
    "test": "node --test --enable-source-maps \"dist/test/**/*.test.js\"",
    "check": "npm run clean && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "playwright-core": "1.61.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.3"
  }
}
