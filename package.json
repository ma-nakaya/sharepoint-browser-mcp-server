{
  "name": "sharepoint-browser-mcp-server",
  "version": "0.8.0",
  "description": "Read-only SharePoint MCP server using an authenticated Microsoft Edge session without Entra app registration.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/src/index.js",
    "prelogin": "npm run build",
    "login": "node --env-file-if-exists=.env --enable-source-maps dist/src/login.js",
    "tunnel:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tunnel-client.ps1 -Action Init",
    "tunnel:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tunnel-client.ps1 -Action Doctor",
    "tunnel:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tunnel-client.ps1 -Action Run",
    "tunnel:install-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-tunnel-scheduled-task.ps1",
    "tunnel:restart-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-tunnel-scheduled-task.ps1",
    "dev": "npm run build && npm start",
    "pretest": "npm run build",
    "test": "node --test --enable-source-maps \"dist/test/**/*.test.js\"",
    "check": "npm run clean && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.1.200",
    "playwright-core": "1.61.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.3"
  }
}
